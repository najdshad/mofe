generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String?
  role            String    @default("user")
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions         Session[]
  venueMembers     VenueMember[]
  uploadedAssets   Asset[]       @relation("UploadedAssets")
  authoredLogs     AuditLog[]    @relation("ActorLogs")
  createdPublications MenuPublication[] @relation("PublicationCreator")
  passwordResetTokens PasswordResetToken[]
}

model Venue {
  id             String    @id @default(uuid())
  nameFa         String
  nameEn         String?
  slug           String    @unique
  plan           String    @default("starter")
  timezone       String    @default("Asia/Tehran")
  accentColor    String?
  welcomeMessage String?
  logoAssetId    String?
  publicStatus   String    @default("draft")
  publishedAt    DateTime?
  unpublishedAt  DateTime?
  menuPhotoMode  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members      VenueMember[]
  categories   Category[]
  menuItems    MenuItem[]
  assets       Asset[]
  publications MenuPublication[]
  domains      Domain[]
  auditLogs    AuditLog[]
  stationSchedules StationSchedule[]
  
}

model VenueMember {
  id          String   @id @default(uuid())
  venueId     String
  userId      String
  role        String
  permissions String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
}

model Category {
  id           String    @id @default(uuid())
  venueId      String
  nameFa       String
  displayOrder Int
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@index([venueId, displayOrder])
  @@index([venueId, active])
}

model MenuItem {
  id                  String    @id @default(uuid())
  venueId             String
  categoryId          String
  nameFa              String
  nameEn              String?
  description         String?
  priceToman          Int
  station             String
  calories            Int?
  photoAssetId        String?
  visibleOnPublicMenu Boolean   @default(true)
  isSoldOut           Boolean   @default(false)
  displayOrder        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  variants MenuItemVariant[]
  allergens MenuItemAllergen[]

  @@index([venueId, categoryId, displayOrder])
  @@index([venueId, visibleOnPublicMenu])
  @@index([venueId, station])
  @@index([venueId, isSoldOut])
}

model Asset {
  id              String   @id @default(uuid())
  venueId         String?
  kind            String
  bucket          String
  objectKey       String
  publicUrl       String?
  contentType     String
  byteSize        Int
  width           Int?
  height          Int?
  checksum        String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  venue    Venue? @relation(fields: [venueId], references: [id])
  uploader User?  @relation("UploadedAssets", fields: [createdByUserId], references: [id])
}

model MenuPublication {
  id              String    @id @default(uuid())
  venueId         String
  status          String    @default("queued")
  trigger         String
  snapshot        String?
  staticAssetId   String?
  errorMessage    String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  venue   Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  creator User? @relation("PublicationCreator", fields: [createdByUserId], references: [id])
}

model Domain {
  id                String    @id @default(uuid())
  venueId           String
  type              String
  hostname          String    @unique
  status            String    @default("pending")
  verificationToken String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model StationSchedule {
  id         String   @id @default(uuid())
  venueId    String
  station    String
  dayOfWeek  Int
  startTime  String
  endTime    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, station])
  @@index([venueId, dayOfWeek])
}

model MenuItemVariant {
  id          String   @id @default(uuid())
  menuItemId  String
  nameFa      String
  nameEn      String?
  priceModifier Int    @default(0)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, displayOrder])
}

model MenuItemAllergen {
  id           String   @id @default(uuid())
  menuItemId   String
  allergenCode String
  createdAt    DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, allergenCode])
  @@index([menuItemId])
}

model AuditLog {
  id          String   @id @default(uuid())
  venueId     String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    String?
  createdAt   DateTime @default(now())

  venue Venue? @relation(fields: [venueId], references: [id])
  actor User?  @relation("ActorLogs", fields: [actorUserId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
