generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  phone               String?
  passwordHash        String?
  role                String    @default("user")
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  status              String    @default("active")
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions         Session[]
  venueMembers     VenueMember[]
  uploadedAssets   Asset[]       @relation("UploadedAssets")
  authoredLogs     AuditLog[]    @relation("ActorLogs")
  createdPublications MenuPublication[] @relation("PublicationCreator")
  passwordResetTokens PasswordResetToken[]
}

model Venue {
  id             String    @id @default(uuid())
  nameFa         String
  nameEn         String?
  slug           String    @unique
  plan           String    @default("starter")
  timezone       String    @default("Asia/Tehran")
  accentColor    String?
  welcomeMessage String?
  logoAssetId    String?
  publicStatus   String    @default("draft")
  publishedAt    DateTime?
  unpublishedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members      VenueMember[]
  categories   Category[]
  menuItems    MenuItem[]
  assets       Asset[]
  publications MenuPublication[]
  domains      Domain[]
  auditLogs    AuditLog[]
  sales            Sale[]
  stationSchedules StationSchedule[]
  tables           VenueTable[]
}

model VenueMember {
  id          String   @id @default(uuid())
  venueId     String
  userId      String
  role        String
  permissions String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
}

model Category {
  id           String    @id @default(uuid())
  venueId      String
  nameFa       String
  displayOrder Int
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@index([venueId, displayOrder])
  @@index([venueId, active])
}

model MenuItem {
  id                  String    @id @default(uuid())
  venueId             String
  categoryId          String
  nameFa              String
  nameEn              String?
  description         String?
  priceToman          Int
  station             String
  calories            Int?
  photoAssetId String?
  isSoldOut    Boolean   @default(false)
  displayOrder        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  variants MenuItemVariant[]
  prices MenuItemPrice[]
  allergens MenuItemAllergen[]

  @@index([venueId, categoryId, displayOrder])
  @@index([venueId, station])
  @@index([venueId, isSoldOut])
}

model Asset {
  id              String   @id @default(uuid())
  venueId         String?
  kind            String
  bucket          String
  objectKey       String
  publicUrl       String?
  contentType     String
  byteSize        Int
  width           Int?
  height          Int?
  checksum        String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  venue    Venue? @relation(fields: [venueId], references: [id])
  uploader User?  @relation("UploadedAssets", fields: [createdByUserId], references: [id])
}

model MenuPublication {
  id              String    @id @default(uuid())
  venueId         String
  status          String    @default("queued")
  trigger         String
  snapshot        String?
  staticAssetId   String?
  errorMessage    String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  venue   Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  creator User? @relation("PublicationCreator", fields: [createdByUserId], references: [id])
}

model Domain {
  id                String    @id @default(uuid())
  venueId           String
  type              String
  hostname          String    @unique
  status            String    @default("pending")
  verificationToken String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model StationSchedule {
  id         String   @id @default(uuid())
  venueId    String
  station    String
  dayOfWeek  Int
  startTime  String
  endTime    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, station])
  @@index([venueId, dayOfWeek])
}

model MenuItemVariant {
  id          String   @id @default(uuid())
  menuItemId  String
  nameFa      String
  nameEn      String?
  priceModifier Int    @default(0)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, displayOrder])
}

model MenuItemPrice {
  id          String   @id @default(uuid())
  menuItemId  String
  description String
  priceToman  Int
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, displayOrder])
}

model MenuItemAllergen {
  id           String   @id @default(uuid())
  menuItemId   String
  allergenCode String
  createdAt    DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, allergenCode])
  @@index([menuItemId])
  @@index([allergenCode])
}

enum VenueTableStatus {
  FREE
  ACTIVE
  READY
  SETTLED
}

model VenueTable {
  id        String           @id @default(uuid())
  venueId   String
  number    Int
  label     String?
  status    VenueTableStatus @default(FREE)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, number])
  @@index([venueId, isActive])
}

/// Managed by Go ordering-service — Prisma should not alter
model orders {
  id           String   @id @default("")
  venue_id     String?
  waiter_id    String?
  table_number String?
  guest_count  Int?
  status       String?
  subtotal     Int?
  total        Int?
  notes        String?
  created_at   DateTime?
  sent_to_kitchen_at DateTime?
  ready_at     DateTime?
  delivered_at DateTime?
  cancelled_at DateTime?
  completed_at DateTime?
  created_by_name String?

  @@ignore
}

/// Managed by Go ordering-service — Prisma should not alter
model order_items {
  id           String   @id @default("")
  order_id     String?
  menu_item_id String?
  menu_item_name String?
  variant_id   String?
  variant_name String?
  quantity     Int?
  unit_price   Int?
  total_price  Int?
  station      String?
  status       String?
  notes        String?
  sent_at      DateTime?
  preparing_at DateTime?
  ready_at     DateTime?
  delivered_at DateTime?
  cancelled_at DateTime?
  course_number Int?
  created_at   DateTime?

  @@ignore
}

model Sale {
  id          String   @id @default(uuid())
  venueId     String   @map("venue_id")
  orderId     String   @unique @map("order_id")
  total       Int      @default(0)
  itemCount   Int      @default(0) @map("item_count")
  completedAt DateTime @default(now()) @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, completedAt])
  @@map("Sale")
}

model AuditLog {
  id          String   @id @default(uuid())
  venueId     String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    String?
  createdAt   DateTime @default(now())

  venue Venue? @relation(fields: [venueId], references: [id])
  actor User?  @relation("ActorLogs", fields: [actorUserId], references: [id])

  @@index([venueId])
  @@index([actorUserId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RateLimitEntry {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, lastActivityAt])
}
