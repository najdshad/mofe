generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  phone               String?
  passwordHash        String?
  role                String    @default("user")
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  status              String    @default("active")
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions         Session[]
  venueMembers     VenueMember[]
  uploadedAssets   Asset[]       @relation("UploadedAssets")
  authoredLogs     AuditLog[]    @relation("ActorLogs")
  createdPublications MenuPublication[] @relation("PublicationCreator")
  passwordResetTokens PasswordResetToken[]
}

model Venue {
  id             String    @id @default(uuid())
  nameFa         String
  nameEn         String?
  slug           String    @unique
  timezone       String    @default("Asia/Tehran")
  accentColor    String?
  welcomeMessage String?
  logoUrl        String?
  menuPhotoMode  Boolean   @default(false)
  publicStatus   String    @default("draft")
  publishedAt    DateTime?
  unpublishedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members      VenueMember[]
  categories   Category[]
  menuItems    MenuItem[]
  assets       Asset[]
  publications MenuPublication[]
  auditLogs    AuditLog[]
}

model VenueMember {
  id          String   @id @default(uuid())
  venueId     String
  userId      String
  permissions String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
  @@index([userId])
}

model Category {
  id           String    @id @default(uuid())
  venueId      String
  nameFa       String
  displayOrder Int @default(0)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@unique([venueId, nameFa])
  @@index([venueId, displayOrder])
  @@index([venueId, active])
  @@index([venueId, updatedAt])
}

model MenuItem {
  id                  String    @id @default(uuid())
  venueId             String
  categoryId          String
  nameFa              String
  nameEn              String?
  description         String?
  priceToman          Int @default(0)
  station             String
  calories            Int?
  photoUrl        String?
  isSoldOut       Boolean   @default(false)
  displayOrder    Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants MenuItemVariant[]
  prices MenuItemPrice[]
  allergens MenuItemAllergen[]

  @@unique([categoryId, nameFa])
  @@index([categoryId])
  @@index([venueId, categoryId, displayOrder])
  @@index([venueId, station])
  @@index([venueId, isSoldOut])
  @@index([venueId, updatedAt])
}

model Asset {
  id              String   @id @default(uuid())
  venueId         String?
  kind            String
  bucket          String
  objectKey       String
  publicUrl       String?
  contentType     String
  byteSize        Int
  width           Int?
  height          Int?
  checksum        String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  venue    Venue? @relation(fields: [venueId], references: [id], onDelete: Cascade)
  uploader User?  @relation("UploadedAssets", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([createdByUserId])
  @@index([kind])
}

model MenuPublication {
  id              String    @id @default(uuid())
  venueId         String
  status          String    @default("queued")
  trigger         String
  snapshot        String?
  staticAssetUrl   String?
  errorMessage    String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  venue   Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  creator User? @relation("PublicationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([status])
  @@index([createdByUserId])
}

model MenuItemVariant {
  id          String   @id @default(uuid())
  menuItemId  String
  nameFa      String
  nameEn      String?
  priceModifier Int    @default(0)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, displayOrder])
}

model MenuItemPrice {
  id          String   @id @default(uuid())
  menuItemId  String
  description String
  priceToman  Int @default(0)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, displayOrder])
}

model MenuItemAllergen {
  id           String   @id @default(uuid())
  menuItemId   String
  allergenCode String
  createdAt    DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, allergenCode])
  @@index([menuItemId])
  @@index([allergenCode])
}

model AuditLog {
  id          String   @id @default(uuid())
  venueId     String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    String?
  createdAt   DateTime @default(now())

  venue  Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)
  actor  User?  @relation("ActorLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([venueId, createdAt])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RateLimitEntry {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([resetAt])
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, lastActivityAt])
}
