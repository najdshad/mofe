generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  status       String   @default("active")
  failedLoginAttempts Int @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions    Session[]
  ownedVenues Venue[]
  subscription Subscription?
  payments    Payment[]
}

model Venue {
  id             String    @id @default(uuid())
  ownerId        String
  nameFa         String
  nameEn         String?
  slug           String    @unique
  themeId        String    @default("classic")
  accentColor    String?
  welcomeMessage String?
  logoUrl        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories Category[]
  menuItems  MenuItem[]
  ledgerEntries LedgerEntry[]

  @@index([ownerId])
}

model Category {
  id           String    @id @default(uuid())
  venueId      String
  nameFa       String
  displayOrder Int @default(0)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@unique([venueId, nameFa])
  @@index([venueId, displayOrder])
  @@index([venueId, active])
  @@index([venueId, updatedAt])
}

model MenuItem {
  id                  String    @id @default(uuid())
  venueId             String
  categoryId          String
  nameFa              String
  nameEn              String?
  description         String?
  priceToman          Int @default(0)
  calories            Int?
  photoUrl        String?
  isSoldOut       Boolean   @default(false)
  displayOrder    Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants MenuItemVariant[]
  prices MenuItemPrice[]
  allergens MenuItemAllergen[]
  saleLineItems SaleLineItem[]

  @@unique([categoryId, nameFa])
  @@index([categoryId])
  @@index([venueId, categoryId, displayOrder])
  @@index([venueId, isSoldOut])
  @@index([venueId, updatedAt])
}

model MenuItemVariant {
  id          String   @id @default(uuid())
  menuItemId  String
  nameFa      String
  nameEn      String?
  priceModifier Int    @default(0)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  saleLineItems SaleLineItem[]

  @@index([menuItemId, displayOrder])
}

model MenuItemPrice {
  id          String   @id @default(uuid())
  menuItemId  String
  description String
  priceToman  Int @default(0)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, displayOrder])
}

model MenuItemAllergen {
  id           String   @id @default(uuid())
  menuItemId   String
  allergenCode String
  createdAt    DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, allergenCode])
  @@index([menuItemId])
  @@index([allergenCode])
}

model LedgerEntry {
  id          String   @id @default(uuid())
  venueId     String
  type        String
  amountToman Int
  description String?
  tags        String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue     Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  saleItems SaleLineItem[]

  @@index([venueId, occurredAt])
  @@index([venueId, type, occurredAt])
}

model SaleLineItem {
  id             String  @id @default(uuid())
  ledgerEntryId  String
  menuItemId     String?
  itemName       String
  unitPriceToman Int
  quantity       Int
  totalToman     Int

  ledgerEntry LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  menuItem    MenuItem?   @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  variant     MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId   String?
  variantName String?

  @@index([ledgerEntryId])
  @@index([menuItemId])
}

model RateLimitEntry {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([resetAt])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model Subscription {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  plan                   String   @default("trial")
  status                 String   @default("trialing")
  provider               String   @default("manual")
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)
  canceledAt             DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([status, currentPeriodEnd])
}

model Payment {
  id                    String   @id @default(uuid())
  userId                String
  subscriptionId        String?
  provider              String   @default("manual")
  providerPaymentId     String?
  plan                  String
  amountToman           Int
  currency              String   @default("IRR")
  status                String   @default("pending")
  checkoutUrl           String?
  paidAt                DateTime?
  metadata              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@index([status])
}
