{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mofe-menu",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "mofe.ir/*",
      "zone_name": "mofe.ir"
    },
    {
      "pattern": "www.mofe.ir/*",
      "zone_name": "mofe.ir"
    }
  ],
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mofe-menu",
      "database_id": "2b869840-39bd-4b18-bf17-27887beef904",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
