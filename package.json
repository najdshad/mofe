{
  "name": "mofe-menu",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply mofe-menu --local",
    "db:remote": "wrangler d1 migrations apply mofe-menu --remote",
    "template": "node scripts/build-template.mjs",
    "seed:generate": "node scripts/seed-from-design.mjs",
    "fonts": "node scripts/extract-fonts.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
